{
  "metadata": {
    "name": "DT-SDG 3/16 Technology-Mechanism-Outcome Codebook",
    "version": "1.0.0",
    "method": "Dictionary- and rule-based computer-assisted content analysis with sentence-level evidence and mandatory human validation",
    "unit_of_analysis": "Technology-outcome relationship reported in a sentence or tightly linked adjacent sentence pair",
    "important_note": "Automated candidates are not final codes. Retain the evidence text and complete the human review fields before inferential analysis."
  },
  "technologies": [
